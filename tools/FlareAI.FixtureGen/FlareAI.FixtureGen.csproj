<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Dev tool, never shipped: turns the bundled style guide into rule coverage fixtures (tests/fixtures/rules). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>FlareAI.FixtureGen</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlareAI.Core\FlareAI.Core.csproj" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Declarative inputs travel next to the binary so the test project can find them. -->
    <None Include="expectations.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="structure-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="templates\*.htm" CopyToOutputDirectory="PreserveNewest" LinkBase="templates" />
  </ItemGroup>

</Project>
